			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class CELTPurchaseInvoices extends FormRun
{
    // Per-row cache for the newest writeback status row of the document being rendered: the
    // Clear status columns are display methods that all read the same row, so the first one
    // pays the select and the rest reuse it. Keyed on the header RecId.
    ClearTaxEInvoiceResponseTable wbCache;
    RecId                         wbCacheHeaderRecId;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// All purchase e-invoices landed by the writeback, newest issue date first.
    /// </summary>
    public void init()
    {
        super();

        CLREInvoiceAPHeader_ds.query().dataSourceTable(tableNum(CLREInvoiceAPHeader)).addSortField(fieldNum(CLREInvoiceAPHeader, IssueDate), SortOrder::Descending);

        this.applyCountryVisibility();
    }

]]></Source>
			</Method>
			<Method>
				<Name>applyCountryVisibility</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checkbox-driven visibility (Company capabilities setup): the buyer lifecycle menu and the
    /// action log follow the company's Lifecycle actions box. The document list and its Clear
    /// status columns always show - landed documents apply in every company.
    /// </summary>
    private void applyCountryVisibility()
    {
        boolean lifecycleOn = CELTLifecycleActionService::isLifecycleActionsVisible();

        element.design().controlName(formControlStr(CELTPurchaseInvoices, CELTLifecycleMenu)).visible(lifecycleOn);
        element.design().controlName(formControlStr(CELTPurchaseInvoices, BtnActionLog)).visible(lifecycleOn);
    }

]]></Source>
			</Method>
			<Method>
				<Name>findWriteback</Name>
				<Source><![CDATA[
    /// <summary>
    /// The newest Clear writeback status row for the purchase document - matched on the invoice
    /// id (the header's document number) - cached per header row so the grid's status columns
    /// cost one select per rendered row instead of one per column.
    /// </summary>
    /// <param name = "_header">the purchase e-invoice header being rendered</param>
    /// <returns>newest writeback row; an empty buffer when none has landed</returns>
    public ClearTaxEInvoiceResponseTable findWriteback(CLREInvoiceAPHeader _header)
    {
        if (wbCacheHeaderRecId != _header.RecId)
        {
            wbCache.clear();

            if (_header.DocumentNo != '')
            {
                // Match current rows (InvoiceId) and legacy-shaped rows (invoice number in
                // DocumentId), like the response log's filter. Newest by creation time - RecId
                // order is not chronological across AOS sessions (per-AOS id blocks).
                select firstonly wbCache
                    order by CreatedDateTime desc, RecId desc
                    where wbCache.InvoiceId == _header.DocumentNo
                       || wbCache.DocumentId == _header.DocumentNo;
            }

            wbCacheHeaderRecId = _header.RecId;
        }

        return wbCache;
    }

]]></Source>
			</Method>
			<Method>
				<Name>invalidateWritebackCache</Name>
				<Source><![CDATA[
    /// <summary>
    /// Forgets the cached writeback row so the next render re-reads it from the table.
    /// </summary>
    public void invalidateWritebackCache()
    {
        wbCacheHeaderRecId = 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>research</Name>
				<Source><![CDATA[
    /// <summary>
    /// Re-reads the grid after an action (lifecycle buttons run on this form's rows). The
    /// writeback cache must be dropped first, or the re-render of the current row would show
    /// the pre-action values.
    /// </summary>
    /// <param name = "_retainPosition">keep the cursor on the current row</param>
    public void research(boolean _retainPosition = true)
    {
        this.invalidateWritebackCache();
        CLREInvoiceAPHeader_ds.research(_retainPosition);
    }

]]></Source>
			</Method>
