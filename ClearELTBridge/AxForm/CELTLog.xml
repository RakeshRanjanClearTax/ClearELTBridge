			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sorts newest first. Opened from an invoice list with a selected record, shows only the
    /// log lines stamped with that invoice's number (lines written before the stamp existed have
    /// no number and stay under the full log).
    /// </summary>
    public void init()
    {
        CustInvoiceJour custJour;
        ProjInvoiceJour projJour;
        VendInvoiceJour vendJour;
        str             docId;

        super();

        if (element.args() && element.args().record())
        {
            switch (element.args().dataset())
            {
                case tableNum(CustInvoiceJour):
                    custJour = element.args().record() as CustInvoiceJour;
                    docId    = custJour.InvoiceId;
                    break;

                case tableNum(ProjInvoiceJour):
                    projJour = element.args().record() as ProjInvoiceJour;
                    docId    = projJour.ProjInvoiceId;
                    break;

                case tableNum(VendInvoiceJour):
                    vendJour = element.args().record() as VendInvoiceJour;
                    docId    = vendJour.InvoiceId;
                    break;
            }
        }

        if (docId != '')
        {
            CELTLog_ds.query().dataSourceTable(tableNum(CELTLog)).addRange(fieldNum(CELTLog, InvoiceId)).value(SysQuery::value(docId));
        }

        CELTLog_ds.query().dataSourceTable(tableNum(CELTLog)).addSortField(fieldNum(CELTLog, CreatedDateTime), SortOrder::Descending);
    }

]]></Source>
			</Method>
