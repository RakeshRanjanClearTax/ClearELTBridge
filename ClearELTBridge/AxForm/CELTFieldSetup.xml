				<Source><![CDATA[
/// <summary>
/// Per-company on/off switch for every CELT custom input field. Disabled fields are hidden on
/// their forms the next time the form opens; nothing else changes - stored values stay untouched.
/// </summary>
[Form]
public class CELTFieldSetup extends FormRun
{
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Seeds any missing field rows (enabled by default) and sorts by the field label.
    /// </summary>
    public void init()
    {
        CELTFieldSetup::ensureSeeded();

        super();

        CELTFieldSetup_ds.query().dataSourceTable(tableNum(CELTFieldSetup)).addSortField(fieldNum(CELTFieldSetup, Description), SortOrder::Ascending);
    }

]]></Source>
