			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Opened from an invoice, shows only that document's attempts; standalone, shows all,
    /// newest first.
    /// </summary>
    public void init()
    {
        CustInvoiceJour     custJour;
        ProjInvoiceJour     projJour;
        CLREInvoiceAPHeader apHeader;
        str                 invoiceId;

        super();

        if (element.args() && element.args().record())
        {
            switch (element.args().dataset())
            {
                case tableNum(CustInvoiceJour):
                    custJour  = element.args().record() as CustInvoiceJour;
                    invoiceId = custJour.InvoiceId;
                    break;

                case tableNum(ProjInvoiceJour):
                    projJour  = element.args().record() as ProjInvoiceJour;
                    invoiceId = projJour.ProjInvoiceId;
                    break;

                case tableNum(CLREInvoiceAPHeader):
                    apHeader  = element.args().record() as CLREInvoiceAPHeader;
                    invoiceId = apHeader.DocumentNo;
                    break;
            }
        }

        if (invoiceId != '')
        {
            CELTLifecycleActionLog_ds.query().dataSourceTable(tableNum(CELTLifecycleActionLog)).addRange(fieldNum(CELTLifecycleActionLog, InvoiceId)).value(queryValue(invoiceId));
        }

        CELTLifecycleActionLog_ds.query().dataSourceTable(tableNum(CELTLifecycleActionLog)).addSortField(fieldNum(CELTLifecycleActionLog, CreatedDateTime), SortOrder::Descending);
    }

]]></Source>
