			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class CELTProjInvoices extends FormRun
{
    // Per-row cache for the newest writeback of the row being rendered: the status columns are
    // display methods that all read the same row, so the first one pays the select and the rest
    // reuse it. Keyed on the journal RecId.
    ClearTaxEInvoiceResponseTable wbCache;
    RecId                         wbCacheJourRecId;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// All posted project invoices, newest first, with the Clear e-invoice status columns.
    /// </summary>
    public void init()
    {
        super();

        ProjInvoiceJour_ds.query().dataSourceTable(tableNum(ProjInvoiceJour)).addSortField(fieldNum(ProjInvoiceJour, InvoiceDate), SortOrder::Descending);

        this.applyCountryVisibility();
    }

]]></Source>
			</Method>
			<Method>
				<Name>applyCountryVisibility</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checkbox-driven visibility (Company capabilities setup): the Lifecycle actions box shows
    /// the lifecycle buttons, payment history (button and per-row View column) and action log;
    /// the Self-billing box shows the Generate e-invoice button. The response log and the PDF
    /// download always show.
    /// </summary>
    private void applyCountryVisibility()
    {
        boolean lifecycleOn   = CELTLifecycleActionService::isLifecycleActionsVisible();
        boolean selfBillingOn = CELTLifecycleActionService::isSelfBillingVisible();

        element.design().controlName(formControlStr(CELTProjInvoices, BtnGenerateEInvoice)).visible(selfBillingOn);
        element.design().controlName(formControlStr(CELTProjInvoices, BtnLifecycleMenu)).visible(lifecycleOn);
        element.design().controlName(formControlStr(CELTProjInvoices, BtnPaymentHistory)).visible(lifecycleOn);
        element.design().controlName(formControlStr(CELTProjInvoices, Grid_PaymentHistory)).visible(lifecycleOn);
        element.design().controlName(formControlStr(CELTProjInvoices, BtnActionLog)).visible(lifecycleOn);
    }

]]></Source>
			</Method>
			<Method>
				<Name>findWriteback</Name>
				<Source><![CDATA[
    /// <summary>
    /// The newest Clear writeback row for the project invoice, cached per journal row so the
    /// grid's status columns cost one select per rendered row instead of one per column.
    /// </summary>
    /// <param name = "_projJour">the journal row being rendered</param>
    /// <returns>newest writeback row; an empty buffer when none has landed</returns>
    public ClearTaxEInvoiceResponseTable findWriteback(ProjInvoiceJour _projJour)
    {
        if (wbCacheJourRecId != _projJour.RecId)
        {
            wbCache.clear();

            if (_projJour.ProjInvoiceId != '')
            {
                // Match current rows (InvoiceId) and legacy-shaped rows (invoice number in
                // DocumentId), like the response log's filter. Newest by creation time - RecId
                // order is not chronological across AOS sessions (per-AOS id blocks).
                select firstonly wbCache
                    order by CreatedDateTime desc, RecId desc
                    where wbCache.InvoiceId == _projJour.ProjInvoiceId
                       || wbCache.DocumentId == _projJour.ProjInvoiceId;
            }

            wbCacheJourRecId = _projJour.RecId;
        }

        return wbCache;
    }

]]></Source>
			</Method>
			<Method>
				<Name>invalidateWritebackCache</Name>
				<Source><![CDATA[
    /// <summary>
    /// Forgets the cached writeback row so the next render re-reads it from the table.
    /// </summary>
    public void invalidateWritebackCache()
    {
        wbCacheJourRecId = 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>research</Name>
				<Source><![CDATA[
    /// <summary>
    /// Re-reads the grid after an action - the sync helper and the lifecycle service refresh
    /// their caller through this method. The writeback cache must be dropped first, or the
    /// re-render of the current row would show the pre-action values.
    /// </summary>
    /// <param name = "_retainPosition">keep the cursor on the current row</param>
    public void research(boolean _retainPosition = true)
    {
        this.invalidateWritebackCache();
        ProjInvoiceJour_ds.research(_retainPosition);
    }

]]></Source>
			</Method>
