					<Method>
						<Name>documentId</Name>
						<Source><![CDATA[
        /// <summary>Clear document id - from the newest writeback, else the journal's stamped id.</summary>
        display str documentId(ProjInvoiceJour _projJour)
        {
            // Only a submitted e-invoice shows a document id; failed attempts keep theirs in the
            // E-Invoice response log.
            if (_projJour.CELTEInvoiceStatus != CELTEInvoiceStatus::Submitted)
            {
                return '';
            }

            ClearTaxEInvoiceResponseTable wb = element.findWriteback(_projJour);
            return wb.DocumentId != '' ? wb.DocumentId : _projJour.CELTDocumentId;
        }

]]></Source>
