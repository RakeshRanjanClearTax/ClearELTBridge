				<Source><![CDATA[
/// <summary>
/// The request and reply for one lifecycle action, side by side - the fastest way to see whether
/// a rejection was about the business key, the date format or the action itself.
/// </summary>
[Form]
public class CELTLifecycleExchange extends FormRun
{
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Shows the log row it was opened from; standalone it shows the newest attempt.
    /// </summary>
    public void init()
    {
        CELTLifecycleActionLog callerLog;

        super();

        if (element.args() && element.args().record() && element.args().dataset() == tableNum(CELTLifecycleActionLog))
        {
            callerLog = element.args().record() as CELTLifecycleActionLog;
            CELTLifecycleActionLog_ds.query().dataSourceTable(tableNum(CELTLifecycleActionLog)).addRange(fieldNum(CELTLifecycleActionLog, RecId)).value(queryValue(callerLog.RecId));
        }

        CELTLifecycleActionLog_ds.query().dataSourceTable(tableNum(CELTLifecycleActionLog)).addSortField(fieldNum(CELTLifecycleActionLog, CreatedDateTime), SortOrder::Descending);
    }

]]></Source>
