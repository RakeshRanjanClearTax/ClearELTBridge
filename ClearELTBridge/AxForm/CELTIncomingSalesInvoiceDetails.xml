				<Source><![CDATA[
    /// <summary>
    /// When opened from the purchase invoice list, shows only the selected document; lines and
    /// VAT breakdown follow the header through their DocumentNo relation.
    /// </summary>
    public void init()
    {
        CLREInvoiceARHeader callerRec;

        super();

        if (element.args() && element.args().record() && element.args().dataset() == tableNum(CLREInvoiceARHeader))
        {
            callerRec = element.args().record() as CLREInvoiceARHeader;
            CLREInvoiceARHeader_ds.query().dataSourceTable(tableNum(CLREInvoiceARHeader)).addRange(fieldNum(CLREInvoiceARHeader, RecId)).value(queryValue(callerRec.RecId));
        }
    }

]]></Source>
