			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// When opened from an invoice journal with a selected record, shows only that invoice's
    /// writeback rows - matched on InvoiceId, or DocumentId for legacy-shaped rows. Opened
    /// standalone, shows all, newest first.
    /// </summary>
    public void init()
    {
        CustInvoiceJour custJour;
        ProjInvoiceJour projJour;
        VendInvoiceJour vendJour;
        str             docId;

        super();

        if (element.args() && element.args().record())
        {
            switch (element.args().dataset())
            {
                case tableNum(CustInvoiceJour):
                    custJour = element.args().record() as CustInvoiceJour;
                    docId    = custJour.InvoiceId;
                    break;

                case tableNum(ProjInvoiceJour):
                    projJour = element.args().record() as ProjInvoiceJour;
                    docId    = projJour.ProjInvoiceId;
                    break;

                case tableNum(VendInvoiceJour):
                    vendJour = element.args().record() as VendInvoiceJour;
                    docId    = vendJour.InvoiceId;
                    break;
            }
        }

        if (docId != '')
        {
            // Match current rows (InvoiceId) and legacy-shaped rows (invoice number in DocumentId).
            ClearTaxEInvoiceResponseTable_ds.query().dataSourceTable(tableNum(ClearTaxEInvoiceResponseTable)).addRange(fieldNum(ClearTaxEInvoiceResponseTable, RecId)).value(
                strFmt('((%1.InvoiceId == "%2") || (%1.DocumentId == "%2"))',
                    tableStr(ClearTaxEInvoiceResponseTable),
                    strReplace(docId, '"', '')));
        }

        ClearTaxEInvoiceResponseTable_ds.query().dataSourceTable(tableNum(ClearTaxEInvoiceResponseTable)).addSortField(fieldNum(ClearTaxEInvoiceResponseTable, CreatedDateTime), SortOrder::Descending);
    }

]]></Source>
