			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Opened from an invoice, shows only that document's reported payments; standalone, all.
    /// </summary>
    public void init()
    {
        CustInvoiceJour custJour;
        ProjInvoiceJour projJour;
        str             invoiceId;

        super();

        if (element.args() && element.args().record())
        {
            switch (element.args().dataset())
            {
                case tableNum(CustInvoiceJour):
                    custJour  = element.args().record() as CustInvoiceJour;
                    invoiceId = custJour.InvoiceId;
                    break;

                case tableNum(ProjInvoiceJour):
                    projJour  = element.args().record() as ProjInvoiceJour;
                    invoiceId = projJour.ProjInvoiceId;
                    break;
            }
        }

        if (invoiceId != '')
        {
            CELTPaymentReportLine_ds.query().dataSourceTable(tableNum(CELTPaymentReportLine)).addRange(fieldNum(CELTPaymentReportLine, InvoiceId)).value(queryValue(invoiceId));
        }

        CELTPaymentReportLine_ds.query().dataSourceTable(tableNum(CELTPaymentReportLine)).addSortField(fieldNum(CELTPaymentReportLine, CreatedDateTime), SortOrder::Descending);
    }

]]></Source>
