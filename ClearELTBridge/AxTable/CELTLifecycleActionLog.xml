	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// One row per lifecycle action attempt (Clear France API v4.1 - 6/8), successful or not, with
/// the request body and reply. The row is written and COMMITTED before any error is raised, so a
/// rejected action leaves a readable record instead of being rolled back with the failure.
/// </summary>
public class CELTLifecycleActionLog extends common
{
}
]]></Declaration>
