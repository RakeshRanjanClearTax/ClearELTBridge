	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Landing table for e-invoice (GENERATE_IRN) writeback results. Field schema is compatible with
/// the original ELTIRN_WRITEBACK (the backend writeback config still names that table; the posting
/// service maps it here). One row per invoice, upserted on UniqueId. Per-company: the sync flow
/// lands rows in the company whose journal raised the request, so consumers scope correctly.
/// </summary>
public class ClearTaxEInvoiceResponseTable extends common
{
}
]]></Declaration>
