		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the CURRENT COMPANY's parameters record, creating nothing. The table saves per
    /// company (entity-specific setup: a UAE entity never sees the France endpoints or token),
    /// so the plain select is already scoped to curExt().
    /// </summary>
    /// <param name = "_forUpdate">select for update when true</param>
    /// <returns>the CELTParameters record</returns>
    public static CELTParameters find(boolean _forUpdate = false)
    {
        CELTParameters parameter;

        if (_forUpdate)
        {
            parameter.selectForUpdate(_forUpdate);
        }

        // Deterministic: prefer the seeded record (Primary = 1), then lowest RecId - an unordered
        // firstonly can pick a different row than the parameters form displays when duplicates exist.
        select firstonly parameter
            order by Primary desc, RecId asc;
        return parameter;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Indicates whether a parameters record has been configured.
    /// </summary>
    /// <returns>true when a row exists</returns>
    public static boolean exist()
    {
        return (select firstonly RecId from CELTParameters).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getAuthToken</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the authentication token maintained in Clear ELT parameters.
    /// </summary>
    /// <returns>token string</returns>
    public static str getAuthToken()
    {
        return CELTParameters::find().AuthToken;
    }

]]></Source>
			</Method>
		</Methods>
